root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{kt,kts}]
max_line_length = 120

[*.{py,pyi}]
max_line_length = 100

[*.{swift,m,h,cpp,cs}]
indent_size = 4
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{sh,bash}]
end_of_line = lf

[Makefile]
indent_style = tab
