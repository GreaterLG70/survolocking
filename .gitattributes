# 强制统一换行符，避免 Windows/Linux 协作差异导致的 diff 噪音
*               text=auto eol=lf

# 源码类
*.py            text eol=lf
*.kt            text eol=lf
*.kts           text eol=lf
*.java          text eol=lf
*.swift         text eol=lf
*.m             text eol=lf
*.h             text eol=lf
*.cs            text eol=lf
*.js            text eol=lf
*.ts            text eol=lf
*.vue           text eol=lf
*.dart          text eol=lf
*.go            text eol=lf
*.rs            text eol=lf
*.cpp           text eol=lf
*.c             text eol=lf
*.hpp           text eol=lf

# 配置类
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.toml          text eol=lf
*.ini           text eol=lf
*.conf          text eol=lf
*.properties    text eol=lf

# 文档
*.md            text eol=lf
*.txt           text eol=lf
LICENSE         text eol=lf

# 脚本
*.sh            text eol=lf
*.bat           text eol=lf
gradlew         text eol=lf
gradlew.bat     text eol=lf

# 模板不应归并冲突
gradle/wrapper/gradle-wrapper.jar  binary

# 二进制 / 资源
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.icns          binary
*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary
*.mp4           binary
*.mp3           binary
*.zip           binary
*.gz            binary
*.tar           binary
*.tgz           binary
*.7z            binary
*.pdf           binary

# 差异与归并
.gitattributes  merge=union
.gitignore      merge=union
.gitkeep        -whitespace
