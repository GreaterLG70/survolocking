# ============================================================
# Survolocking 环境变量模板
# 复制为 .env 后填写。所有密钥只存此文件，切勿提交到代码仓库。
# ============================================================

# ------------------------------------------------------------ 基础
APP_NAME=Survolocking
# dev / staging / prod。prod 下无 MySQL 将拒绝启动
APP_ENV=dev
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------ 安全（生产必须覆盖）
# JWT 签名密钥：openssl rand -hex 32
JWT_SECRET=
# 号码哈希盐值：openssl rand -hex 32。上线后绝不可更改，否则历史哈希全部失配
PHONE_HASH_SALT=

# ------------------------------------------------------------ MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=survolocking
# 无建库权限时启用表前缀模式，留空表示使用独立库
MYSQL_TABLE_PREFIX=
MYSQL_SSL=false

# ------------------------------------------------------------ Redis（可选）
# 留空则使用进程内内存缓存。多实例部署时必须配置
REDIS_URL=

# ------------------------------------------------------------ DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60
DEEPSEEK_ENABLED=true

# ------------------------------------------------------------ 起零数据
QILING_TOKEN=
QILING_BASE_URL=https://api.istero.com/httptool/service/spam-call-checker
# 起零（iStero）骚扰号码查询，实测响应 ~3.7s。
# 本服务不在实时决策链路上（端侧第2层走「本地缓存 + 后台预热」），仅服务
# 端侧后台预热与手动查询，故超时给足 6s；查询失败自动降级，不阻塞任何链路。
QILING_TIMEOUT=6.0
QILING_ENABLED=true
QILING_CACHE_TTL=300

# ------------------------------------------------------------ 短信验证码
# dev        = 不真实发送（验证码回显，联调用）
# aliyun     = 阿里云「短信服务」dysmsapi SendSms
#              需企业资质才能申请签名。自 2025-06 起个人认证账号无法新增自用资质，
#              个人开发者会因签名报备失败而发送不了，请改用 aliyun_pns。
#              签名/模板在「短信服务 → 国内消息」申请，模板 CODE 为 SMS_ 前缀。
# aliyun_pns = 阿里云「号码认证服务 - 短信认证」dypnsapi SendSmsVerifyCode【推荐/个人可用】
#              免资质、免签名申请、免模板申请，用平台赠送的签名与模板。
#              取值来自号码认证控制台：赠送签名配置 / 赠送模板配置。
#              注意：赠送签名必须搭配赠送模板使用，且不支持自定义签名。
#              验证码由阿里云生成并保管，校验走 CheckSmsVerifyCode。
# tencent    = 腾讯云短信
SMS_PROVIDER=dev
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_REGION=cn-hangzhou
# 发送间隔频控（秒），对应号码认证 Interval 参数
SMS_SEND_INTERVAL=60
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_APPID=

# ------------------------------------------------------------ 推送
# dev=仅落站内通知(APP轮询) / fcm / apns
PUSH_PROVIDER=dev
FCM_CREDENTIALS_JSON=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# ------------------------------------------------------------ 业务参数
ANALYSIS_BATCH_SIZE=500
RULE_CONFIDENCE_THRESHOLD=0.7
ANALYSIS_DAILY_LIMIT_PER_FAMILY=2
FAMILY_AGGREGATION_MIN_USERS=2
FAMILY_SPAM_RATIO=0.8
FAMILY_SAFE_RATIO=0.3
ANALYSIS_CRON_HOUR=2
ANALYSIS_CRON_MINUTE=0

# ------------------------------------------------------------ 运维
# 生产环境必须设置，用于保护 /api/admin/* 接口
ADMIN_TOKEN=
