<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 暗色磨砂玻璃主题：基于 MaterialComponents，应用启动时强制夜模式 -->
    <style name="Theme.Survolocking" parent="Theme.MaterialComponents.DayNight.NoActionBar.Bridge">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:colorBackground">@color/bg_deep</item>
        <item name="android:windowBackground">@drawable/bg_app_gradient</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialCardViewStyle">@style/Widget.Survolocking.GlassCard</item>
        <item name="bottomNavigationStyle">@style/Widget.Survolocking.BottomNav</item>
        <item name="materialButtonStyle">@style/Widget.Survolocking.Button</item>
    </style>

    <!-- 玻璃卡片 -->
    <style name="Widget.Survolocking.GlassCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/glass</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- 底部导航：玻璃质感 -->
    <style name="Widget.Survolocking.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/glass_strong</item>
        <item name="itemIconTint">@color/bottom_nav_tint</item>
        <item name="itemTextColor">@color/bottom_nav_tint</item>
        <item name="itemRippleColor">@color/primary</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- 主按钮：青绿渐变 + 按压回弹 -->
    <style name="Widget.Survolocking.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 通话后标记浮层（保留） -->
    <style name="Theme.Survolocking.Transparent" parent="Theme.Survolocking">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- Splash：全屏沉浸（隐藏状态栏 / 导航栏），windowBackground=深色避免白闪 -->
    <style name="Theme.Survolocking.Splash" parent="Theme.Survolocking">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="CardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CardBody">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Survolocking.NavActive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
    </style>
    <style name="TextAppearance.Survolocking.NavInactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
